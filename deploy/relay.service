# /etc/systemd/system/relay.service
[Unit]
Description=relay — E2E message relay
After=network.target

[Service]
Type=simple
User=relay
Group=relay
ExecStart=/srv/relay/relay
Environment=RELAY_ADDR=127.0.0.1:8010
# v0 is opt-in. The public relay keeps it for the migration; a new relay
# needs only v1 and should leave this unset.
Environment=RELAY_V0=on
# systemd creates /var/lib/relay owned by the service user, 0700.
StateDirectory=relay
StateDirectoryMode=0700
Environment=RELAY_STATE_PATH=/var/lib/relay/channels.json
Environment=RELAY_KEYS_PATH=/etc/relay/keys.json
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
